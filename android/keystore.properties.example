# Copier vers keystore.properties (gitignored) et renseigner les valeurs.
# Générer le keystore :
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore app/afrikatrans-upload.keystore \
#     -alias afrikatrans-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=afrikatrans-upload.keystore
keyAlias=afrikatrans-upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
